---
import PostCard from './PostCard.astro';
import { withBase, type Post } from '../utils';

interface Props {
  posts: Post[];
  page?: number;
  totalPages?: number;
}
const { posts, page = 1, totalPages = 1 } = Astro.props;
---

{
  posts.length === 0 ? (
    <div class="card empty">这里还没有文章，敬请期待 ~</div>
  ) : (
    <>
      <div class="post-list">
        {posts.map((p) => (
          <PostCard post={p} />
        ))}
      </div>

      {totalPages > 1 && (
        <nav class="pagination">
          {page > 1 && (
            <a class="page-num" href={page === 2 ? withBase('/') : withBase(`/page/${page - 1}/`)}>
              ‹
            </a>
          )}
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
            <a class={`page-num ${n === page ? 'active' : ''}`} href={n === 1 ? withBase('/') : withBase(`/page/${n}/`)}>
              {n}
            </a>
          ))}
          {page < totalPages && <a class="page-num" href={withBase(`/page/${page + 1}/`)}>›</a>}
        </nav>
      )}
    </>
  )
}
