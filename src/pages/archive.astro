---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortPosts, formatDate } from '../utils';

const all = sortPosts(await getCollection('posts', ({ data }) => !data.draft));

const groups = new Map<number, typeof all>();
for (const p of all) {
  const y = p.data.published.getFullYear();
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y)!.push(p);
}
const years = [...groups.keys()].sort((a, b) => b - a);
---

<BaseLayout title="归档">
  <div class="container" style="padding-top:1.25rem;">
    <div class="card">
      <div class="page-head">
        <h1>归档</h1>
        <p>共 {all.length} 篇文章 · 点击分类或标签可筛选</p>
      </div>

      <div id="filter-bar" style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem;font-size:0.85rem;">
        <span style="color:var(--text-mute);align-self:center;">当前筛选：</span>
        <span id="filter-label" class="tag">全部</span>
        <a href="/archive/" id="filter-clear" style="color:var(--text-mute);align-self:center;">清除</a>
      </div>

      <div id="archive-list">
        {
          years.map((y) => (
            <section>
              <div class="archive-year">{y}</div>
              {groups.get(y)!.map((p) => (
                <div
                  class="archive-item"
                  data-category={p.data.category}
                  data-tags={(p.data.tags ?? []).join(',')}
                >
                  <span class="archive-date">{formatDate(p.data.published)}</span>
                  <a href={`/posts/${p.id}/`}>{p.data.title}</a>
                </div>
              ))}
            </section>
          ))
        }
      </div>
      <div id="archive-empty" class="empty" style="display:none;">没有符合条件的文章</div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const params = new URLSearchParams(location.search);
    const cat = params.get('category');
    const tag = params.get('tag');
    if (!cat && !tag) {
      document.getElementById('filter-bar').style.display = 'none';
      return;
    }
    document.getElementById('filter-label').textContent = cat ? cat : '#' + tag;

    let shown = 0;
    document.querySelectorAll('.archive-item').forEach((el) => {
      let ok = false;
      if (cat) ok = el.dataset.category === cat;
      else if (tag) ok = (el.dataset.tags || '').split(',').includes(tag);
      el.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });

    document.querySelectorAll('.archive-year').forEach((h) => {
      const sec = h.parentElement;
      const visible = [...sec.querySelectorAll('.archive-item')].filter(
        (e) => e.style.display !== 'none'
      );
      sec.style.display = visible.length ? '' : 'none';
    });

    if (shown === 0) document.getElementById('archive-empty').style.display = '';
  })();
</script>
