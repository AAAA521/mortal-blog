---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { formatDate, sortPosts, wordCount, readingTime, withBase } from '../../utils';

export async function getStaticPaths() {
  const all = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
  return all.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      all,
      prev: all[i + 1] ?? null,
      next: all[i - 1] ?? null,
    },
  }));
}

const { post, all, prev, next } = Astro.props;
const { Content } = await render(post);
const words = wordCount(post.body ?? '');
const minutes = readingTime(post.body ?? '');
const { title, published, category, tags, description } = post.data;
---

<BaseLayout title={title} description={description}>
  <div class="container" style="padding-top:1.25rem;">
    <div class="main-grid">
      <Sidebar posts={all} />
      <main>
        <article class="card" style="padding:1.75rem;">
          <header class="post-header">
            <h1>{title}</h1>
            <div class="post-meta">
              <span>{formatDate(published)}</span>
              <span class="dot"></span>
              <a href={withBase(`/archive/?category=${encodeURIComponent(category)}`)}>{category}</a>
              <span class="dot"></span>
              <span>{words} 字</span>
              <span class="dot"></span>
              <span>{minutes} 分钟</span>
            </div>
            {
              tags && tags.length > 0 && (
                <div class="post-tags">
                  {tags.map((t) => (
                    <a class="tag" href={withBase(`/archive/?tag=${encodeURIComponent(t)}`)}>
                      #{t}
                    </a>
                  ))}
                </div>
              )
            }
          </header>

          <div class="prose">
            <Content />
          </div>

          <nav class="post-nav">
            {
              prev ? (
                <a href={withBase(`/posts/${prev.id}/`)}>‹ {prev.data.title}</a>
              ) : (
                <span />
              )
            }
            {
              next ? (
                <a href={withBase(`/posts/${next.id}/`)} style="text-align:right;">
                  {next.data.title} ›
                </a>
              ) : (
                <span />
              )
            }
          </nav>
        </article>
      </main>
    </div>
  </div>
</BaseLayout>
