---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils';
---

<BaseLayout title="404">
  <div class="container" style="padding-top:2rem;">
    <div class="card empty" style="padding:4rem 1rem;">
      <div style="font-size:3rem;font-weight:800;color:var(--primary);">404</div>
      <p style="margin:0.75rem 0 1.25rem;">页面走丢了，也许是 URL 敲错了。</p>
      <a class="chip" href={withBase('/')}>← 回到主页</a>
    </div>
  </div>
</BaseLayout>
